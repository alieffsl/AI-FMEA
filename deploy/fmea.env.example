# Runtime settings for the FMEA API.
# Copy to /etc/fmea/fmea.env, replace every CHANGE_ME value, then use
# owner root, group ubuntu, and mode 640 so the ubuntu PM2 process can read it.

NODE_ENV=production
HOST=127.0.0.1
PORT=3001

PG_HOST=CHANGE_ME
PG_PORT=5432
PG_USER=CHANGE_ME
PG_PASSWORD=CHANGE_ME
PG_DATABASE=CHANGE_ME
