[Unit]
Description=AI FMEA Tooling Copilot API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fmea/server
EnvironmentFile=/etc/fmea/fmea.env
ExecStart=/usr/bin/node /home/ubuntu/fmea/server/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
