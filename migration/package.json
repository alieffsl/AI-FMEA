{
  "name": "fmea-migration",
  "version": "1.0.0",
  "description": "Maintained PostgreSQL knowledge-base preparation and validation tools",
  "type": "module",
  "scripts": {
    "schema:application": "node run_02_schema.cjs",
    "schema:checklist": "node run_db_migration.cjs",
    "database:optimize": "node run_optimizations.cjs",
    "normalize:populate": "ts-node --esm populate_normalized_tool_descriptions.ts",
    "normalize:verify": "ts-node --esm verify_normalization.ts",
    "normalize:test": "ts-node --esm test_normalize.ts",
    "synthesize:local": "ts-node --esm synthesize_all.ts",
    "synthesize:openai": "ts-node --esm synthesize_all_openai.ts",
    "checklist:create": "ts-node --esm create_checklist_table.ts",
    "checklist:generate": "ts-node --esm generate_checklist.ts",
    "checklist:verify": "ts-node --esm verify_checklist.ts",
    "checklist-standard:generate": "ts-node --esm generate_checklist_standard.ts",
    "checklist-standard:verify": "ts-node --esm verify_checklist_standard.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^6.45.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
